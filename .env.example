OPENROUTER_API_KEY=sk-or-...
COUNCIL_DEFAULT_PRESET=glm-stack

# Council authorization identity is separate from OPENROUTER_API_KEY.
# Blank ID uses the stable local OS user declaration.
COUNCIL_PRINCIPAL_ID=
# Narrow to `read` for a read-only principal.
COUNCIL_PRINCIPAL_SCOPES=read,filesystem:mutate,test,shell,high-risk:manage

# Optional process-local service/test verifier for fresh high-risk step-up.
# This is independent of --yes, OPENROUTER_API_KEY, principal scopes, and grants.
COUNCIL_AUTH_SECRET=

# Workspace root for tool path validation (default: current working directory)
COUNCIL_WORKSPACE_ROOT=

# Maximum tool calls per council run (default: 50)
COUNCIL_MAX_TOOL_CALLS=50
